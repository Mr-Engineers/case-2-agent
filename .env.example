# proxy  = LLM and apps through proxy-server (PROXY_URL required; URLs below default to it)
# direct = Bedrock and the apps without the proxy, for tests (CASE_DESK_URL, CARD_NETWORK_URL required)
AGENT_MODE=proxy

# LLM: Chat Completions (OpenAI-compatible). In direct mode auth comes from the AWS credential
# chain (ECS task role on Fargate, AWS_PROFILE locally) unless LLM_API_KEY is set.
# In proxy mode defaults to <PROXY_URL>/v1 with AGENT_KEY.
# LLM_BASE_URL=https://bedrock-runtime.eu-north-1.amazonaws.com/openai/v1
LLM_MODEL=qwen.qwen3-32b-v1:0
AWS_REGION=eu-north-1
LLM_THINK=false

# proxy mode: app calls go to <PROXY_URL>/apps/case_desk and <PROXY_URL>/apps/card_network
PROXY_URL=http://localhost:8080
AGENT_KEY=

# direct mode: the apps themselves, Authorization: Bearer = their MCP_API_KEY
# CASE_DESK_URL=http://localhost:4102
# CASE_DESK_TOKEN=
# CARD_NETWORK_URL=http://localhost:4101
# CARD_NETWORK_TOKEN=

# Only these cases (comma-separated, e.g. one scenario); empty = every open case
CASE_IDS=
# User message of each session (the cardholder's request)
# CASE_TASK=The cardholder disputes this charge. Review the network dispute and resolve the case appropriately.

POLL_INTERVAL_S=30
MAX_PARALLEL_SESSIONS=4
MAX_LLM_STEPS=12
# true = one scan of the open cases, wait for all sessions, exit
RUN_ONCE=false
